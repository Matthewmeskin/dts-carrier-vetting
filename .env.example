# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth / session
# Minutes of inactivity before a signed-in user is auto-logged-out (default 30).
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30
# Absolute max session length in hours regardless of activity (default 12).
NEXT_PUBLIC_SESSION_MAX_HOURS=12
# Email 2FA: require an emailed 6-digit code after password login. Off unless
# set to "true" (needs RESEND_API_KEY + ALERT_EMAIL_FROM configured).
MFA_ENABLED=false
# Optional secret to sign the MFA cookie; falls back to the service-role key.
# MFA_COOKIE_SECRET=change_me
# Days a "remembered" device skips the emailed code (default 30).
NEXT_PUBLIC_MFA_TRUST_DAYS=30

# RMIS
RMIS_CLIENT_ID=your_4_digit_client_id
RMIS_CLIENT_PASSWORD=your_rmis_password
RMIS_BASE_URL=https://api.rmissecure.com

# FMCSA proxy — fallback authority/operating-status/safety data for carriers
# that aren't in RMIS. Token for the DTS FMCSA proxy (same one the n8n workflow
# uses). FMCSA_PROXY_URL is optional; it defaults to the hosted proxy.
FMCSA_PROXY_TOKEN=your_fmcsa_proxy_token
# FMCSA_PROXY_URL=https://fmcsa-proxy.onrender.com/fmcsa

# Google Drive
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id

# Email
RESEND_API_KEY=your_resend_key
ALERT_EMAIL_FROM=compliance@dtsone.com
ALERT_EMAIL_TO=matthew@dtsone.com,operations@dtsone.com

# Secretary-of-State enrichment (OpenSOS + Haiku)
OPENSOS_API_KEY=your_opensos_api_key
# OPENSOS_BASE_URL=https://api.opensosdata.com   # optional override
ANTHROPIC_API_KEY=your_anthropic_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=make_up_a_long_random_string_here

# Payment vetting (AP) — n8n webhook that runs the doc analysis + builds the log.
# Production URL of the "DTS Payment Vetting" workflow's webhook trigger.
N8N_PAYMENT_VETTING_WEBHOOK_URL=https://matthewmeskin.app.n8n.cloud/webhook/dts-payment-vetting
# PDF renderer (browserless) used to render the Carrier Profile page that gets
# merged into the payment vetting report. Full URL incl. token — the same
# endpoint the n8n workflow uses.
BROWSERLESS_PDF_URL=https://production-sfo.browserless.io/pdf?token=your_browserless_token
# Optional: a Google Maps key usable server-side (Static Maps + Street View
# Static APIs enabled) for the satellite/Street View images on the Carrier
# Profile page. Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. If that key is
# HTTP-referrer-restricted, set an unrestricted/IP-restricted key here instead.
GOOGLE_MAPS_STATIC_KEY=your_server_google_maps_key
