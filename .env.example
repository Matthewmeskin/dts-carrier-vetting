# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# RMIS
RMIS_CLIENT_ID=your_4_digit_client_id
RMIS_CLIENT_PASSWORD=your_rmis_password
RMIS_BASE_URL=https://api.rmissecure.com

# FMCSA proxy — fallback authority/operating-status/safety data for carriers
# that aren't in RMIS. Token for the DTS FMCSA proxy (same one the n8n workflow
# uses). FMCSA_PROXY_URL is optional; it defaults to the hosted proxy.
FMCSA_PROXY_TOKEN=your_fmcsa_proxy_token
# FMCSA_PROXY_URL=https://fmcsa-proxy.onrender.com/fmcsa

# Google Drive
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id

# Email
RESEND_API_KEY=your_resend_key
ALERT_EMAIL_FROM=compliance@dtsone.com
ALERT_EMAIL_TO=matthew@dtsone.com,operations@dtsone.com

# Secretary-of-State enrichment (OpenSOS + Haiku)
OPENSOS_API_KEY=your_opensos_api_key
# OPENSOS_BASE_URL=https://api.opensosdata.com   # optional override
ANTHROPIC_API_KEY=your_anthropic_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=make_up_a_long_random_string_here

# Payment vetting (AP) — n8n webhook that runs the doc analysis + builds the log.
# Production URL of the "DTS Payment Vetting" workflow's webhook trigger.
N8N_PAYMENT_VETTING_WEBHOOK_URL=https://matthewmeskin.app.n8n.cloud/webhook/dts-payment-vetting
